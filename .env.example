# LiveKit Cloud project (room broker / SFU). The agent joins this same room.
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Local Flask backend (clone voice + ghost image). The Next.js API routes proxy to it.
BACKEND_URL=http://localhost:5001

# Optional: override the connection-details endpoint (defaults to /api/connection-details)
NEXT_PUBLIC_CONN_DETAILS_ENDPOINT=
